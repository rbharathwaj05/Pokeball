{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StoryToneTemplatePack",
  "type": "object",
  "required": ["tone", "name", "templates"],
  "properties": {
    "tone": { "type": "string" },
    "name": { "type": "string" },
    "templates": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["text", "required_fields"],
          "properties": {
            "text": { "type": "string" },
            "required_fields": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
